<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_maintenance" model="ir.module.category">
        <field name="name">Mantenimiento de equipos</field>
        <field name="sequence">30</field>
    </record>
    <record id="group_maintenance_user" model="res.groups">
        <field name="name">Usuario</field>
        <field name="category_id" ref="module_category_maintenance"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_maintenance_manager" model="res.groups">
        <field name="name">Responsable</field>
        <field name="category_id" ref="module_category_maintenance"/>
        <field name="implied_ids" eval="[(4, ref('group_maintenance_user'))]"/>
    </record>
    <record id="rule_task_assigned" model="ir.rule">
        <field name="name">Usuario: solo tareas asignadas</field>
        <field name="model_id" ref="model_equipment_maintenance_task"/>
        <field name="groups" eval="[(4, ref('group_maintenance_user'))]"/>
        <field name="domain_force">[('responsible_id', '=', user.id)]</field>
    </record>
    <record id="rule_task_manager" model="ir.rule">
        <field name="name">Responsable: todas las tareas</field>
        <field name="model_id" ref="model_equipment_maintenance_task"/>
        <field name="groups" eval="[(4, ref('group_maintenance_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
    <record id="rule_equipment_assigned" model="ir.rule">
        <field name="name">Usuario: equipos de sus tareas asignadas</field>
        <field name="model_id" ref="model_equipment_maintenance_equipment"/>
        <field name="groups" eval="[(4, ref('group_maintenance_user'))]"/>
        <field name="domain_force">[('task_ids.responsible_id', '=', user.id)]</field>
    </record>
    <record id="rule_equipment_manager" model="ir.rule">
        <field name="name">Responsable: todos los equipos</field>
        <field name="model_id" ref="model_equipment_maintenance_equipment"/>
        <field name="groups" eval="[(4, ref('group_maintenance_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
</odoo>
