<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="task_view_list" model="ir.ui.view">
        <field name="name">equipment.maintenance.task.list</field>
        <field name="model">equipment.maintenance.task</field>
        <field name="arch" type="xml">
            <list string="Tareas de mantenimiento" decoration-success="state == 'done'" decoration-muted="state == 'cancelled'">
                <field name="equipment_id"/><field name="equipment_code"/>
                <field name="responsible_id"/><field name="planned_date"/>
                <field name="hours" widget="float_time"/><field name="state" widget="badge"/>
            </list>
        </field>
    </record>
    <record id="task_view_form" model="ir.ui.view">
        <field name="name">equipment.maintenance.task.form</field>
        <field name="model">equipment.maintenance.task</field>
        <field name="arch" type="xml">
            <form string="Tarea de mantenimiento">
                <header>
                    <button name="action_start" type="object" string="Iniciar" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_done" type="object" string="Marcar como hecha" class="btn-primary" invisible="state not in ('draft', 'in_progress')"/>
                    <button name="action_cancel" type="object" string="Cancelar" invisible="state in ('done', 'cancelled')"/>
                    <button name="action_draft" type="object" string="Volver a borrador" invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,in_progress,done,cancelled"/>
                </header>
                <sheet>
                    <field name="equipment_image" widget="image" class="oe_avatar" readonly="1"/>
                    <group>
                        <group><field name="equipment_id"/><field name="equipment_code"/><field name="responsible_id"/></group>
                        <group><field name="planned_date"/><field name="hours" widget="float_time"/></group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="task_view_kanban" model="ir.ui.view">
        <field name="name">equipment.maintenance.task.kanban</field>
        <field name="model">equipment.maintenance.task</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" quick_create="false" group_create="false" group_delete="false">
                <templates><t t-name="card">
                    <field name="equipment_image" widget="image" options="{'size': [96, 96]}"/>
                    <field name="equipment_id" class="fw-bold"/>
                    <div>Referencia: <field name="equipment_code"/></div>
                    <field name="state" widget="badge"/>
                    <field name="responsible_id" widget="many2one_avatar_user"/>
                    <field name="planned_date"/>
                    <field name="hours" widget="float_time"/>
                </t></templates>
            </kanban>
        </field>
    </record>
    <record id="task_view_search" model="ir.ui.view">
        <field name="name">equipment.maintenance.task.search</field>
        <field name="model">equipment.maintenance.task</field>
        <field name="arch" type="xml">
            <search>
                <field name="equipment_id"/><field name="equipment_code"/>
                <field name="responsible_id"/><field name="state"/>
                <filter name="draft" string="Borrador" domain="[('state', '=', 'draft')]"/>
                <filter name="in_progress" string="En curso" domain="[('state', '=', 'in_progress')]"/>
                <filter name="done" string="Hecha" domain="[('state', '=', 'done')]"/>
                <filter name="cancelled" string="Cancelada" domain="[('state', '=', 'cancelled')]"/>
                <separator/>
                <filter name="my_tasks" string="Mis tareas" domain="[('responsible_id', '=', uid)]"/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_state" string="Estado" context="{'group_by': 'state'}"/>
                    <filter name="group_responsible" string="Responsable" context="{'group_by': 'responsible_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="task_action" model="ir.actions.act_window">
        <field name="name">Tareas de mantenimiento</field><field name="res_model">equipment.maintenance.task</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="task_view_search"/>
    </record>
</odoo>
