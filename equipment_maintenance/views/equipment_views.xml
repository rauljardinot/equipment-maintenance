<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="equipment_view_list" model="ir.ui.view">
        <field name="name">equipment.maintenance.equipment.list</field>
        <field name="model">equipment.maintenance.equipment</field>
        <field name="arch" type="xml">
            <list string="Equipos"><field name="name"/><field name="code"/><field name="location"/><field name="total_maintenance_hours" widget="float_time" sum="Total horas"/></list>
        </field>
    </record>
    <record id="equipment_view_form" model="ir.ui.view">
        <field name="name">equipment.maintenance.equipment.form</field>
        <field name="model">equipment.maintenance.equipment</field>
        <field name="arch" type="xml">
            <form string="Equipo">
                <sheet>
                    <field name="image_1920" widget="image" class="oe_avatar"/>
                    <group><field name="name"/><field name="code"/><field name="location"/><field name="total_maintenance_hours" widget="float_time"/></group>
                    <notebook><page string="Tareas de mantenimiento">
                        <field name="task_ids" context="{'default_equipment_id': id}">
                            <list><field name="responsible_id"/><field name="planned_date"/><field name="hours" widget="float_time"/><field name="state"/></list>
                        </field>
                    </page></notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="equipment_view_kanban" model="ir.ui.view">
        <field name="name">equipment.maintenance.equipment.kanban</field>
        <field name="model">equipment.maintenance.equipment</field>
        <field name="arch" type="xml">
            <kanban><templates><t t-name="card">
                <field name="image_1920" widget="image" options="{'size': [96, 96]}"/>
                <field name="name" class="fw-bold"/>
                <field name="code"/><field name="location"/>
                <div>Horas totales: <field name="total_maintenance_hours" widget="float_time"/></div>
            </t></templates></kanban>
        </field>
    </record>
    <record id="equipment_view_search" model="ir.ui.view">
        <field name="name">equipment.maintenance.equipment.search</field>
        <field name="model">equipment.maintenance.equipment</field>
        <field name="arch" type="xml">
            <search><field name="name"/><field name="code"/><field name="location"/></search>
        </field>
    </record>
    <record id="equipment_action" model="ir.actions.act_window">
        <field name="name">Equipos</field><field name="res_model">equipment.maintenance.equipment</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="equipment_view_search"/>
    </record>
</odoo>
